[Unit]
Description=Conveyor Service (Random Forest rf_noisy)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/conveyor
Environment="PATH=/home/pi/conveyor/venv/bin:/usr/local/bin:/usr/bin"
Environment="MPLCONFIGDIR=/tmp/matplotlib_conveyor"
ExecStart=/home/pi/conveyor/venv/bin/uvicorn server:app --app-dir /home/pi/conveyor --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
